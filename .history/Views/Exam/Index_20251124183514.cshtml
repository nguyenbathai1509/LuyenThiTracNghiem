@using LuyenThiTracNghiem.Utilities
@model LuyenThiTracNghiem.Areas.Admin.Models.PagedResult<LuyenThiTracNghiem.Models.ViewModels.ExamListItemViewModel>

@{
    Layout = "_Layout";
}

<style>
    .exam-hero {
        background: radial-gradient(circle at 10% 20%, #f9f5ff 0%, #eef2ff 35%, #f8fafc 100%);
        border-radius: 18px;
        padding: 32px;
        border: 1px solid #eef2ff;
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.05);
    }
    .exam-hero .title {
        font-weight: 700;
        letter-spacing: -0.02em;
    }
    .exam-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 12px;
        border-radius: 999px;
        background: #fff;
        box-shadow: 0 6px 18px rgba(99, 102, 241, 0.12);
        color: #4f46e5;
        font-weight: 600;
    }
    .exam-card {
        border: 1px solid #edf2f7;
        border-radius: 14px;
        overflow: hidden;
        transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
        height: 100%;
        background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    }
    .exam-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 20px 38px rgba(15, 23, 42, 0.12);
        border-color: #cbd5e1;
    }
    .exam-cover {
        height: 180px;
        object-fit: cover;
        width: 100%;
        background: #e2e8f0;
    }
    .chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 10px;
        font-size: 13px;
        background: #edf2ff;
        color: #4338ca;
    }
    .stat-icon {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #f1f5f9;
        color: #0ea5e9;
    }
    .pagination .page-link {
        border-radius: 10px;
        margin: 0 4px;
    }
</style>

<div class="container my-4">
    <div class="exam-hero mb-4">
        <div class="row align-items-center g-3">
            <div class="col-lg-8">
                <div class="exam-pill mb-2">
                    <i class="fas fa-layer-group"></i> Bộ sưu tập đề thi
                </div>
                <h2 class="title mb-2">Khám phá tất cả đề thi</h2>
                <p class="text-muted mb-0">Lựa chọn đề phù hợp và vào xem chi tiết trước khi làm bài.</p>
            </div>
            <div class="col-lg-4 text-lg-end">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-2 rounded-3 bg-white shadow-sm">
                    <span class="stat-icon"><i class="far fa-file-alt"></i></span>
                    <div>
                        <div class="text-muted small">Tổng đề</div>
                        <div class="fw-bold fs-5">@Model.TotalItems</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Items.Any())
    {
        <div class="row g-4">
            @foreach (var exam in Model.Items)
            {
                var url = Functions.TitleSlugGeneration("exam", exam.ExamName, exam.ExamId);
                <div class="col-lg-4 col-md-6">
                    <div class="exam-card h-100">
                        @if (!string.IsNullOrWhiteSpace(exam.Image))
                        {
                            <img src="@exam.Image" class="exam-cover" alt="@exam.ExamName" loading="lazy">
                        }
                        <div class="p-3 d-flex flex-column h-100">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="chip">
                                    <i class="fas fa-book-open"></i>
                                    @exam.SubjectName
                                </span>
                                <small class="text-muted">@exam.CreatedAt.ToString("dd/MM/yyyy")</small>
                            </div>
                            <h5 class="fw-semibold mb-2">
                                <a href="/@url" class="text-decoration-none text-dark">@exam.ExamName</a>
                            </h5>
                            <div class="d-flex flex-wrap gap-2 mb-3 text-muted small">
                                <span class="badge rounded-pill bg-light text-dark px-3 py-2">
                                    <i class="far fa-clock me-1"></i>@exam.DurationMinutes phút
                                </span>
                                <span class="badge rounded-pill bg-light text-dark px-3 py-2">
                                    <i class="far fa-question-circle me-1"></i>@exam.QuestionCount câu
                                </span>
                                <span class="badge rounded-pill @(exam.ExamFee > 0 ? "bg-warning-subtle text-warning" : "bg-success-subtle text-success") px-3 py-2">
                                    <i class="fas fa-coins me-1"></i>
                                    @(exam.ExamFee > 0 ? exam.ExamFee.ToString("N0") + " đ" : "Miễn phí")
                                </span>
                            </div>
                            <div class="mt-auto d-flex justify-content-between align-items-center">
                                <div class="text-muted small d-flex align-items-center gap-2">
                                    <i class="far fa-eye"></i>
                                    <span>Xem chi tiết</span>
                                </div>
                                <a class="btn btn-sm btn-primary px-3" href="/@url">
                                    Bắt đầu
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        if (Model.TotalPages > 1)
        {
            <nav aria-label="Pagination" class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = Model.PageNumber - 1, pageSize = Model.PageSize })">Trước</a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { page = i, pageSize = Model.PageSize })">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = Model.PageNumber + 1, pageSize = Model.PageSize })">Sau</a>
                    </li>
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="alert alert-info mb-0">
            Hiện chưa có đề thi nào khả dụng.
        </div>
    }
</div>
