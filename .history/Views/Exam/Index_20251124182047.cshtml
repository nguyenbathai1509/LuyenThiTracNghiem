@using LuyenThiTracNghiem.Utilities
@model LuyenThiTracNghiem.Areas.Admin.Models.PagedResult<LuyenThiTracNghiem.Models.ViewModels.ExamListItemViewModel>

@{
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="row align-items-center mb-3">
        <div class="col">
            <h3 class="mb-1">Tất cả đề thi</h3>
            <p class="text-muted mb-0">Danh sách đầy đủ đề thi, click để xem chi tiết và làm bài</p>
        </div>
        <div class="col-auto">
            <span class="badge bg-primary-subtle text-primary">
                Tổng cộng: @Model.TotalItems
            </span>
        </div>
    </div>

    @if (Model.Items.Any())
    {
        <div class="row g-4">
            @foreach (var exam in Model.Items)
            {
                var url = Functions.TitleSlugGeneration("exam", exam.ExamName, exam.ExamId);
                <div class="col-lg-4 col-md-6">
                    <div class="card shadow-sm h-100">
                        @if (!string.IsNullOrWhiteSpace(exam.Image))
                        {
                            <img src="@exam.Image" class="card-img-top" alt="@exam.ExamName" loading="lazy" style="height: 180px; object-fit: cover;">
                        }
                        <div class="card-body d-flex flex-column">
                            <span class="text-uppercase text-muted small">@exam.SubjectName</span>
                            <h5 class="mt-1 mb-2">
                                <a href="/@url" class="text-decoration-none">@exam.ExamName</a>
                            </h5>
                            <div class="d-flex flex-wrap gap-2 mb-3 small text-muted">
                                <span><i class="far fa-clock me-1"></i>@exam.DurationMinutes phút</span>
                                <span><i class="far fa-question-circle me-1"></i>@exam.QuestionCount câu</span>
                                <span>
                                    <i class="fas fa-coins me-1"></i>
                                    @(exam.ExamFee > 0 ? exam.ExamFee.ToString("N0") + " đ" : "Miễn phí")
                                </span>
                            </div>
                            <div class="mt-auto d-flex justify-content-between align-items-center">
                                <small class="text-muted">Ngày tạo: @exam.CreatedAt.ToString("dd/MM/yyyy")</small>
                                <a class="btn btn-sm btn-primary" href="/@url">
                                    Vào xem
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        if (Model.TotalPages > 1)
        {
            <nav aria-label="Pagination" class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = Model.PageNumber - 1, pageSize = Model.PageSize })">Trước</a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { page = i, pageSize = Model.PageSize })">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = Model.PageNumber + 1, pageSize = Model.PageSize })">Sau</a>
                    </li>
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="alert alert-info mb-0">
            Hiện chưa có đề thi nào khả dụng.
        </div>
    }
</div>
