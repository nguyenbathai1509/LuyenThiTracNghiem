@model LuyenThiTracNghiem.Models.ViewModels.ExamHistoryViewModel
@{
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/assets/css/exam-history.css" asp-append-version="true" />

<div class="exam-history-hero">
    <div class="exam-history-shell">
        <div class="exam-history-header d-flex justify-content-between align-items-center">
            <div>
                <div class="eyebrow">Lịch sử làm bài</div>
                <h2>Thống kê kết quả</h2>
                <p style="color: #fff;">Người dùng: @Model.UserName (ID: @Model.UserId)</p>
            </div>
            <div class="badge-pill-soft d-none d-md-inline-flex">
                <i class="far fa-clock"></i> Cập nhật mới nhất
            </div>
        </div>

        <div class="exam-history-body">
            @if (Model.Attempts.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle attempt-table">
                        <thead>
                            <tr>
                                <th>Đề thi</th>
                                <th>Môn học</th>
                                <th>Thời gian</th>
                                <th class="text-center">Điểm</th>
                                <th class="text-center">%</th>
                                <th class="text-center">Thời lượng</th>
                                <th class="text-center">Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var attempt in Model.Attempts)
                            {
                                var statusClass = attempt.IsPassed ? "status-pass" : "status-fail";
                                var statusText = attempt.IsPassed ? "Đạt" : "Không đạt";
                                <tr>
                                    <td data-label="Đề thi">@attempt.ExamName</td>
                                    <td data-label="Môn học">@attempt.SubjectName</td>
                                    <td data-label="Thời gian">@attempt.AttemptTime.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td data-label="Điểm" class="text-center">@((attempt.Score ?? 0).ToString("0.##"))</td>
                                    <td data-label="%" class="text-center">@((attempt.PercentScore ?? 0).ToString("0.##"))%</td>
                                    <td data-label="Thời lượng" class="text-center">
                                        @if (attempt.Duration.HasValue)
                                        {
                                            var d = attempt.Duration.Value;
                                            @($"{(int)d.TotalMinutes}p {d.Seconds}s")
                                        }
                                        else
                                        {
                                            @("-")
                                        }
                                    </td>
                                    <td data-label="Trạng thái" class="text-center @statusClass">@statusText</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state text-center">
                    <div class="mb-2"><i class="far fa-clipboard text-primary fs-3"></i></div>
                    <h5 class="mb-1">Chưa có lượt làm bài</h5>
                    <p class="text-muted mb-0">Bạn chưa hoàn thành đề thi nào. Hãy chọn một đề và bắt đầu luyện tập.</p>
                </div>
            }
        </div>
    </div>
</div>
