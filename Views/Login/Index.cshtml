@{
    Layout = "_Layout";
}

<div class="login-hero">
    <div class="login-shell row g-0">
        <div class="col-lg-5 d-none d-lg-block">
            <div class="login-visual h-100">
                <div class="badge-pill mb-3">
                    <i class="fas fa-bolt"></i> Luyện thi nhanh
                </div>
                <div class="text-uppercase small text-white-50 fw-semibold mb-1">Nền tảng trắc nghiệm</div>
                <h2>Đăng nhập để tiếp tục</h2>
                <p>Truy cập kho đề, theo dõi tiến độ và tích điểm thưởng cho mỗi lần hoàn thành bài thi.</p>
                <div class="mt-3">
                    <div class="bullet">
                        <i class="far fa-check-circle"></i><span>Đồng bộ điểm số & lịch sử</span>
                    </div>
                    <div class="bullet">
                        <i class="far fa-check-circle"></i><span>Thi trực tuyến mọi lúc</span>
                    </div>
                    <div class="bullet">
                        <i class="far fa-check-circle"></i><span>Gợi ý đề theo mức độ</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-7">
            <div class="login-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="flex-grow-1">
                        <div class="text-uppercase small text-muted fw-semibold">Chào mừng</div>
                        <h3 class="fw-bold mb-1">Đăng nhập tài khoản</h3>
                        <p class="text-muted mb-0">Điền thông tin để bắt đầu hành trình luyện thi của bạn.</p>
                    </div>
                    <a href="~/" class="d-none d-md-inline-block">
                        <img src="~/assets/img/logo/logo.png"
                             alt="LuyenThiTracNghiem"
                             style="max-width: 80px; height: auto; object-fit: contain;">
                    </a>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                <form id="loginForm" method="post" novalidate>
                    <div class="mb-3 input-stack">
                        <label for="Username" class="form-label">Tên đăng nhập</label>
                        <div class="input-box">
                            <span class="icon"><i class="far fa-user"></i></span>
                            <input type="text"
                                   name="Username"
                                   id="Username"
                                   class="form-control"
                                   autocomplete="username"
                                   placeholder="Nhập tên đăng nhập"
                                   required />
                        </div>
                        <div class="text-danger mt-1" id="UsernameError" style="font-size: 0.85rem;"></div>
                    </div>

                    <div class="mb-3 input-stack">
                        <label for="PasswordHash" class="form-label">Mật khẩu</label>
                        <div class="input-box">
                            <span class="icon"><i class="fas fa-lock"></i></span>
                            <input type="password"
                                   name="PasswordHash"
                                   id="PasswordHash"
                                   class="form-control"
                                   autocomplete="current-password"
                                   placeholder="••••••••"
                                   required />
                        </div>
                        <div class="text-danger mt-1" id="PasswordHashError" style="font-size: 0.85rem;"></div>
                    </div>

                    <button type="submit" class="login-btn">Đăng nhập</button>
                </form>
                <div class="login-footer">
                    <small>Chưa có tài khoản? <a href="~/Register" style="color:#000;">Đăng ký ngay</a></small>
                </div>
            </div>
        </div>
    </div>
</div>
<link rel="stylesheet" href="~/assets/css/login.css" asp-append-version="true" />
<script src="~/assets/js/login-validation.js"></script>