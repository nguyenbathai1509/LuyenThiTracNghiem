@model LuyenThiTracNghiem.Models.ViewModels.ExamResultViewModel

<h2 class="text-center mb-4">@Model.ExamName</h2>

<div class="mb-4 d-flex flex-column align-items-center">
    <p><strong>Điểm:</strong> @Model.Score.ToString("0.00")</p>
    <p><strong>Số câu đúng:</strong> @Model.CorrectCount</p>
    <p><strong>Số câu sai:</strong> @Model.IncorrectCount</p>
    <p><strong>Số câu chưa làm:</strong> @Model.UnansweredCount</p>
</div>

<hr />

<div class="list-group">
    @foreach (var q in Model.Questions)
    {
        <div class="list-group-item mb-2">
            <div class="mb-2">
                <strong>Câu @q.QuestionId:</strong> @q.QuestionText
            </div>
            <ul class="list-group">
                @foreach (var a in q.Answers)
                {
                    var selected = q.UserAnswerId.HasValue && q.UserAnswerId.Value == a.AnswerId;
                    var correct = a.AnswerId == q.CorrectAnswerId;

                    string itemClass = "";
                    if (correct) itemClass = "list-group-item-success";      // Highlight đáp án đúng
                    else if (selected && !correct) itemClass = "list-group-item-danger"; // Highlight sai nếu chọn

                    <li class="list-group-item @itemClass">
                        @if (selected) { <strong>(Chọn)</strong> } @a.AnswerText
                        @if (correct) { <strong> - Đáp án đúng</strong> }
                    </li>
                }
            </ul>
        </div>
    }
</div>


<div class="text-center mt-3" style="">
    <a href="@Url.Action("Index","Home")" class="btn btn-primary">Quay lại Trang chủ</a>
</div>

<link rel="stylesheet" href="~/assets/css/result.css" asp-append-version="true" />
<script src="~/assets/js/result.js" asp-append-version="true"></script>
