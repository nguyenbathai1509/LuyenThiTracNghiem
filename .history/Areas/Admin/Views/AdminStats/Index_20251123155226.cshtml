@model LuyenThiTracNghiem.Areas.Admin.Models.AdminStatsViewModel
@{
    ViewBag.Title = "Thống kê";
    @{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<main id="main" class="main">
    <div class="pagetitle">
        <h1>Thống kê</h1>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item active">Thống kê</li>
            </ol>
        </nav>
    </div>

    <section class="section dashboard">
        <div class="row">
            <div class="col-xxl-3 col-md-6 mb-3">
                <div class="card info-card">
                    <div class="card-body">
                        <h5 class="card-title">Người dùng</h5>
                        <div class="d-flex align-items-center">
                            <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                <i class="bi bi-people"></i>
                            </div>
                            <div class="ps-3">
                                <h6>@Model.TotalUsers</h6>
                                <span class="text-muted small">Tổng số người dùng</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xxl-3 col-md-6 mb-3">
                <div class="card info-card">
                    <div class="card-body">
                        <h5 class="card-title">Môn học</h5>
                        <div class="d-flex align-items-center">
                            <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                <i class="bi bi-journal-bookmark"></i>
                            </div>
                            <div class="ps-3">
                                <h6>@Model.TotalSubjects</h6>
                                <span class="text-muted small">Tổng số môn</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xxl-3 col-md-6 mb-3">
                <div class="card info-card">
                    <div class="card-body">
                        <h5 class="card-title">Đề thi</h5>
                        <div class="d-flex align-items-center">
                            <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                <i class="bi bi-card-checklist"></i>
                            </div>
                            <div class="ps-3">
                                <h6>@Model.TotalExams</h6>
                                <span class="text-muted small">Tổng số đề</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xxl-3 col-md-6 mb-3">
                <div class="card info-card">
                    <div class="card-body">
                        <h5 class="card-title">Lượt hoàn thành</h5>
                        <div class="d-flex align-items-center">
                            <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                <i class="bi bi-check-circle"></i>
                            </div>
                            <div class="ps-3">
                                <h6>@Model.TotalCompletedAttempts</h6>
                                <span class="text-muted small">Bài thi đã nộp</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title mb-3">Top 5 đề thi được làm nhiều nhất</h5>
                        @if (Model.TopExams.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-striped align-middle">
                                    <thead>
                                        <tr>
                                            <th>Đề thi</th>
                                            <th>Môn học</th>
                                            <th class="text-center">Số lượt làm</th>
                                            <th class="text-center">Điểm TB</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var exam in Model.TopExams)
                                        {
                                            <tr>
                                                <td>@exam.ExamName</td>
                                                <td>@exam.SubjectName</td>
                                                <td class="text-center">@exam.AttemptCount</td>
                                                <td class="text-center">@exam.AvgScore.ToString("0.##")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted mb-0">Chưa có dữ liệu bài làm.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>
