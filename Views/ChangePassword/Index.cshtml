@model LuyenThiTracNghiem.Models.tblUser
@{
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/assets/css/change-password.css" asp-append-version="true" />

<div class="changepass-hero">
    <div class="changepass-shell">
        <div class="changepass-header">
            <div class="eyebrow">Bảo mật tài khoản</div>
            <h2>Đổi mật khẩu</h2>
            <p style="color: #fff;">Thiết lập mật khẩu mới để bảo vệ tài khoản của bạn.</p>
        </div>
        <div class="changepass-body">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form id="changePasswordForm" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3 input-stack">
                    <label for="OldPassword" class="form-label">Mật khẩu cũ</label>
                    <div class="input-box">
                        <span class="icon"><i class="fas fa-lock-open"></i></span>
                        <input type="password" class="form-control" id="OldPassword" name="OldPassword" required />
                    </div>
                    <div class="text-danger mt-1" id="OldPasswordError"></div>
                </div>
                <div class="mb-3 input-stack">
                    <label for="NewPassword" class="form-label">Mật khẩu mới</label>
                    <div class="input-box">
                        <span class="icon"><i class="fas fa-key"></i></span>
                        <input type="password" class="form-control" id="NewPassword" name="NewPassword" required />
                    </div>
                    <div class="text-danger mt-1" id="NewPasswordError"></div>
                </div>
                <div class="mb-3 input-stack">
                    <label for="ConfirmPassword" class="form-label">Xác nhận mật khẩu mới</label>
                    <div class="input-box">
                        <span class="icon"><i class="fas fa-lock"></i></span>
                        <input type="password" class="form-control" id="ConfirmPassword" name="ConfirmPassword" required />
                    </div>
                    <div class="text-danger mt-1" id="ConfirmPasswordError"></div>
                </div>
                <button type="submit" class="action-btn">Đổi mật khẩu</button>
            </form>
        </div>
    </div>
</div>

<script src="~/assets/js/change-password.js"></script>
