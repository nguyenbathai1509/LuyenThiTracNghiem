@model LuyenThiTracNghiem.Models.ViewModels.UserStatsViewModel
@{
    Layout = "_Layout";
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-12 text-center">
            <h2>Thống kê người dùng</h2>
            <p class="text-muted mb-0">@Model.FullName (ID: @Model.UserId)</p>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h6 class="text-muted">Lượt làm bài</h6>
                    <h3 class="mb-0">@Model.TotalAttempts</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h6 class="text-muted">Số đề đã làm</h6>
                    <h3 class="mb-0">@Model.TotalExamsTaken</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h6 class="text-muted">Điểm TB</h6>
                    <h3 class="mb-0">@Model.AvgScore.ToString("0.##")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h6 class="text-muted">% điểm TB</h6>
                    <h3 class="mb-0">@Model.AvgPercentScore.ToString("0.##")%</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h6 class="text-muted">Câu đúng</h6>
                    <h3 class="mb-0 text-success">@Model.TotalCorrect</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h6 class="text-muted">Câu sai</h6>
                    <h3 class="mb-0 text-danger">@Model.TotalWrong</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h6 class="text-muted">Câu bỏ trống</h6>
                    <h3 class="mb-0 text-warning">@Model.TotalUnanswered</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0">Thống kê theo môn</h5>
        </div>
        <div class="card-body">
            @if (Model.SubjectStats.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead>
                            <tr>
                                <th>Môn</th>
                                <th class="text-center">Đề đã làm</th>
                                <th class="text-center">% điểm TB</th>
                                <th class="text-center">Đúng</th>
                                <th class="text-center">Sai</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var subject in Model.SubjectStats)
                            {
                                <tr>
                                    <td>@subject.SubjectName</td>
                                    <td class="text-center">@subject.ExamsTaken</td>
                                    <td class="text-center">@subject.AvgPercentScore.ToString("0.##")%</td>
                                    <td class="text-center text-success">@subject.TotalCorrect</td>
                                    <td class="text-center text-danger">@subject.TotalWrong</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="mb-0 text-muted">Chưa có dữ liệu thống kê theo môn.</p>
            }
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <h5 class="mb-0">Thống kê theo độ khó</h5>
        </div>
        <div class="card-body">
            @if (Model.DifficultyStats.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Độ khó</th>
                                <th class="text-center">Tổng câu trả lời</th>
                                <th class="text-center">Đúng</th>
                                <th class="text-center">% chính xác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var diff in Model.DifficultyStats)
                            {
                                <tr>
                                    <td>@diff.Level</td>
                                    <td class="text-center">@diff.TotalAnswered</td>
                                    <td class="text-center text-success">@diff.CorrectCount</td>
                                    <td class="text-center">@diff.AccuracyPercent.ToString("0.##")%</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="mb-0 text-muted">Chưa có dữ liệu thống kê theo độ khó.</p>
            }
        </div>
    </div>
</div>
