@model LuyenThiTracNghiem.Models.tblUser
@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<main id="main">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Edit user</h2>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form id="registerForm" asp-action="Edit" method="post" enctype="multipart/form-data">

        <input asp-for="UserId" class="form-control" type="hidden"/>

        <div class="mb-3">
            <label asp-for="FullName" class="form-label">Full Name</label>
            <input asp-for="FullName" id="FullName" class="form-control" />
            <div id="FullNameError" class="text-danger"></div>
        </div>

        <div class="mb-3">
            <label asp-for="BirthDate" class="form-label">Birth Date</label>
            <input asp-for="BirthDate" id="BirthDate" type="date" class="form-control" />
            <div id="BirthDateError" class="text-danger"></div>
        </div>

        <div class="mb-3">
            <label asp-for="Gender" class="form-label">Gender</label>
            <select asp-for="Gender" id="Gender" class="form-select">
                <option value="">-- Select Gender --</option>
                <option value="Nam">Nam</option>
                <option value="Nữ">Nữ</option>
                <option value="Khác">Khác</option>
            </select>
            <div id="GenderError" class="text-danger"></div>
        </div>

        <div class="mb-3">
            <label asp-for="Username" class="form-label">Username</label>
            <input asp-for="Username" id="Username" class="form-control" readonly />
            <div id="UsernameError" class="text-danger"></div>
        </div>

        <div class="mb-3">
            <label asp-for="PasswordHash" class="form-label">Password</label>
            <input asp-for="PasswordHash" id="PasswordHash" type="text" class="form-control" />
            <div id="PasswordHashError" class="text-danger"></div>
        </div>

        <div class="mb-3">
            <label asp-for="PhoneNumber" class="form-label">Phone Number</label>
            <input asp-for="PhoneNumber" id="PhoneNumber" class="form-control" />
            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            <div id="PhoneNumberError" class="text-danger"></div>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" id="Email" type="email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
            <div id="EmailError" class="text-danger"></div>
        </div>

        <div class="mb-3">
            <label class="form-label">Avatar</label>
            <input type="file" name="AvatarFile" class="form-control" accept=".jpg,.jpeg,.png,.gif" />
        </div>

        <div class="mb-3">
            <label asp-for="Role" class="form-label">Role</label>
            <select asp-for="Role" id="Role" name="Role" class="form-select">
                <option value="">-- Select Role --</option>
                <option value="1">Admin</option>
                <option value="2">User</option>
            </select>
            <div id="RoleError" class="text-danger"></div>
        </div>

        <div class="mb-3 form-check">
            <input asp-for="Status" class="form-check-input"/>
            <label asp-for="Status" class="form-check-label">Active</label>
        </div>

        <div class="mb-3">
            <label class="form-label">Số dư hiện tại</label>
            <div class="d-flex align-items-center">
                <span class="fw-bold me-2">@Model.Balance.ToString("N0") VND</span>
            </div>
        </div>

        <button type="submit" class="btn btn-success">Save</button>
        <a asp-action="Index" class="btn btn-secondary">Back</a>
    </form>

    <hr class="my-4" />

    <h5>Nạp tiền cho người dùng</h5>
    <form asp-action="TopUp" method="post" class="row g-2 align-items-end">
        @Html.AntiForgeryToken()
        <input type="hidden" name="userId" value="@Model.UserId" />
        <div class="col-md-4 col-sm-6">
            <label class="form-label" for="TopUpAmount">Số tiền (VND)</label>
            <input type="number" class="form-control" id="TopUpAmount" name="amount" min="1000" step="1000" value="10000" required />
        </div>
        <div class="col-md-3 col-sm-6">
            <button type="submit" class="btn btn-primary w-100">Nạp tiền</button>
        </div>
    </form>
</main>

<script src="~/assets/js/register-validation.js"></script>
