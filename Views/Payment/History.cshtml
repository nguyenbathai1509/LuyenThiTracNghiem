@model IEnumerable<LuyenThiTracNghiem.Models.tblPayment>

@{
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/assets/css/payment-history.css" asp-append-version="true" />

<div class="payment-hero">
    <div class="payment-shell">
        <div class="payment-header d-flex justify-content-between align-items-center">
            <div>
                <div class="eyebrow">Lịch sử giao dịch</div>
                <h2>Nạp tiền của bạn</h2>
                <p style="color: #fff;">Theo dõi các lần nạp tiền, trạng thái và mã giao dịch.</p>
            </div>
            <div class="badge-pill-soft d-none d-md-inline-flex">
                <i class="far fa-credit-card"></i> VNPAY & Ví nội bộ
            </div>
        </div>

        <div class="payment-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle payment-table">
                        <thead>
                            <tr>
                                <th>Mã giao dịch</th>
                                <th class="text-center">Số tiền</th>
                                <th class="text-center">Trạng thái</th>
                                <th class="text-center">Phương thức</th>
                                <th class="text-center">Mã VNPAY</th>
                                <th class="text-center">Thời gian</th>
                                <th>Ghi chú</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var payment in Model)
                            {
                                var statusClass = payment.PaymentStatus switch
                                {
                                    "Success" => "badge-soft status-success",
                                    "Pending" => "badge-soft status-pending",
                                    "Failed" => "badge-soft status-failed",
                                    _ => "badge-soft status-default"
                                };

                                <tr>
                                    <td data-label="Mã giao dịch">#@payment.PaymentId</td>
                                    <td data-label="Số tiền" class="text-center fw-semibold">@payment.Amount.ToString("N0") đ</td>
                                    <td data-label="Trạng thái" class="text-center">
                                        <span class="@statusClass">@payment.PaymentStatus</span>
                                    </td>
                                    <td data-label="Phương thức" class="text-center">@payment.PaymentMethod</td>
                                    <td data-label="Mã VNPAY" class="text-center">@(!string.IsNullOrWhiteSpace(payment.TransactionCode) ? payment.TransactionCode : "-")</td>
                                    <td data-label="Thời gian" class="text-center">@payment.PaymentDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td data-label="Ghi chú">@payment.Note</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state text-center">
                    <div class="mb-2"><i class="far fa-clipboard text-primary fs-3"></i></div>
                    <h5 class="mb-1">Chưa có giao dịch nạp tiền</h5>
                    <p class="text-muted mb-0">Bắt đầu nạp tiền để khám phá thêm tính năng và bài thi nâng cao.</p>
                </div>
            }
        </div>
    </div>
</div>
