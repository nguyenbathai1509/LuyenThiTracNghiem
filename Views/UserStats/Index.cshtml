@model LuyenThiTracNghiem.Models.ViewModels.UserStatsViewModel
@{
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/assets/css/user-stats.css" asp-append-version="true" />

<div class="user-stats-hero">
    <div class="user-stats-shell">
        <div class="user-stats-header d-flex justify-content-between align-items-center">
            <div>
                <div class="eyebrow">Thống kê người dùng</div>
                <h2>@Model.FullName</h2>
                <p style="color: #fff;">ID: @Model.UserId</p>
            </div>
            <div class="badge-soft d-none d-md-inline-flex bg-white text-primary px-3 py-2">
                <i class="far fa-user-circle me-2"></i> Tổng quan học tập
            </div>
        </div>

        <div class="user-stats-body">
            <div class="row g-3 mb-3 meta-grid">
                <div class="col-md-3 col-6">
                    <div class="stat-card p-3 h-100 text-center">
                        <div class="title">Lượt làm bài</div>
                        <div class="value">@Model.TotalAttempts</div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="stat-card p-3 h-100 text-center">
                        <div class="title">Số đề đã làm</div>
                        <div class="value">@Model.TotalExamsTaken</div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="stat-card p-3 h-100 text-center">
                        <div class="title">Điểm TB</div>
                        <div class="value">@Model.AvgScore.ToString("0.##")</div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="stat-card p-3 h-100 text-center">
                        <div class="title">% điểm TB</div>
                        <div class="value">@Model.AvgPercentScore.ToString("0.##")%</div>
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-4 meta-grid">
                <div class="col-md-4 col-6">
                    <div class="stat-card p-3 h-100 text-center">
                        <div class="title">Câu đúng</div>
                        <div class="value text-success">@Model.TotalCorrect</div>
                    </div>
                </div>
                <div class="col-md-4 col-6">
                    <div class="stat-card p-3 h-100 text-center">
                        <div class="title">Câu sai</div>
                        <div class="value text-danger">@Model.TotalWrong</div>
                    </div>
                </div>
                <div class="col-md-4 col-12">
                    <div class="stat-card p-3 h-100 text-center">
                        <div class="title">Câu bỏ trống</div>
                        <div class="value text-warning">@Model.TotalUnanswered</div>
                    </div>
                </div>
            </div>

            <div class="section-card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Giao dịch nạp tiền</h5>
                </div>
                <div class="card-body">
                    @if (Model.TotalDeposits > 0)
                    {
                        <div class="row g-3">
                            <div class="col-md-3 col-6">
                                <div class="stat-card p-3 h-100 text-center deposit-card">
                                    <div class="title">Tổng giao dịch</div>
                                    <div class="value">@Model.TotalDeposits</div>
                                </div>
                            </div>
                            <div class="col-md-3 col-6">
                                <div class="stat-card p-3 h-100 text-center deposit-card">
                                    <div class="title">Thành công</div>
                                    <div class="value text-success">@Model.SuccessfulDeposits</div>
                                </div>
                            </div>
                            <div class="col-md-3 col-6">
                                <div class="stat-card p-3 h-100 text-center deposit-card">
                                    <div class="title">Đang xử lý</div>
                                    <div class="value text-warning">@Model.PendingDeposits</div>
                                </div>
                            </div>
                            <div class="col-md-3 col-6">
                                <div class="stat-card p-3 h-100 text-center deposit-card">
                                    <div class="title">Thất bại</div>
                                    <div class="value text-danger">@Model.FailedDeposits</div>
                                </div>
                            </div>
                            <div class="col-md-3 col-6">
                                <div class="stat-card p-3 h-100 text-center deposit-card">
                                    <div class="title">Tổng tiền thành công</div>
                                    <div class="value">@Model.TotalDepositAmount.ToString("N0") đ</div>
                                </div>
                            </div>
                        </div>
                        <p class="text-muted mt-3 mb-0">
                            Lần nạp gần nhất: @Model.LastDepositDate?.ToString("dd/MM/yyyy HH:mm") với số tiền @Model.LastDepositAmount?.ToString("N0") đ
                        </p>
                    }
                    else
                    {
                        <p class="mb-0 text-muted">Chưa có giao dịch nạp tiền.</p>
                    }
                </div>
            </div>

            <div class="section-card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Thống kê theo môn</h5>
                </div>
                <div class="card-body">
                    @if (Model.SubjectStats.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped align-middle table-modern">
                                <thead>
                                    <tr>
                                        <th>Môn</th>
                                        <th class="text-center">Đề đã làm</th>
                                        <th class="text-center">% điểm TB</th>
                                        <th class="text-center">Đúng</th>
                                        <th class="text-center">Sai</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var subject in Model.SubjectStats)
                                    {
                                        <tr>
                                            <td>@subject.SubjectName</td>
                                            <td class="text-center">@subject.ExamsTaken</td>
                                            <td class="text-center">@subject.AvgPercentScore.ToString("0.##")%</td>
                                            <td class="text-center text-success">@subject.TotalCorrect</td>
                                            <td class="text-center text-danger">@subject.TotalWrong</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="mb-0 text-muted">Chưa có dữ liệu thống kê theo môn.</p>
                    }
                </div>
            </div>

            <div class="section-card">
                <div class="card-header">
                    <h5 class="mb-0">Thống kê theo độ khó</h5>
                </div>
                <div class="card-body">
                    @if (Model.DifficultyStats.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered align-middle table-modern">
                                <thead class="table-light">
                                    <tr>
                                        <th>Độ khó</th>
                                        <th class="text-center">Tổng câu trả lời</th>
                                        <th class="text-center">Đúng</th>
                                        <th class="text-center">% chính xác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var diff in Model.DifficultyStats)
                                    {
                                        <tr>
                                            <td>@diff.Level</td>
                                            <td class="text-center">@diff.TotalAnswered</td>
                                            <td class="text-center text-success">@diff.CorrectCount</td>
                                            <td class="text-center">@diff.AccuracyPercent.ToString("0.##")%</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="mb-0 text-muted">Chưa có dữ liệu thống kê theo độ khó.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
