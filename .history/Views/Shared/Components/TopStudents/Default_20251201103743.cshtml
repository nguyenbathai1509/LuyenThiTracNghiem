@using LuyenThiTracNghiem.Models;
@model IList<tblUser>

<div class="col-lg-4">
    <div class="section-tittle mb-3 text-center">
        <h3>🏆 Top Học viên</h3>
    </div>

    @if (Model != null && Model.Any())
    {
        var topStudents = Model.Take(5).ToList();
        var placeholder = "https://cdn-icons-png.flaticon.com/512/149/149071.png";
        int i = 1;
        foreach (var s in topStudents)
        {
            var displayName = string.IsNullOrWhiteSpace(s.FullName) ? s.Username : s.FullName;
            var avatar = string.IsNullOrWhiteSpace(s.Avatar) ? placeholder : s.Avatar;
            <div class="top-student text-center mb-3 p-3 border rounded shadow-sm">
                <div class="student-rank rank-@i mx-auto mb-2">@i</div>
                <img src="@avatar" alt="@displayName" class="student-avatar mb-2" style="width:72px;height:72px;border-radius:50%;object-fit:cover;">
                <h6 class="fw-bold mb-1">@displayName</h6>
                <small class="text-muted d-block">Tên đăng nhập: @s.Username</small>
                <small class="text-muted d-block">ID: @s.UserId</small>
            </div>
            i++;
        }
    }
    else
    {
        <p class="text-muted text-center mb-0">Chưa có học viên để hiển thị.</p>
    }
</div>
