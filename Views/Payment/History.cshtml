@model IEnumerable<LuyenThiTracNghiem.Models.tblPayment>

@{
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-12">
            <h3 class="mb-1">Lịch sử giao dịch nạp tiền</h3>
            <p class="text-muted mb-0">Theo dõi các lần nạp tiền của bạn</p>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Mã giao dịch</th>
                                <th class="text-center">Số tiền</th>
                                <th class="text-center">Trạng thái</th>
                                <th class="text-center">Phương thức</th>
                                <th class="text-center">Mã VNPAY</th>
                                <th class="text-center">Thời gian</th>
                                <th>Ghi chú</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var payment in Model)
                            {
                                var statusClass = payment.PaymentStatus switch
                                {
                                    "Success" => "badge bg-success-subtle text-success",
                                    "Pending" => "badge bg-warning-subtle text-warning",
                                    "Failed" => "badge bg-danger-subtle text-danger",
                                    _ => "badge bg-secondary-subtle text-secondary"
                                };

                                <tr>
                                    <td>#@payment.PaymentId</td>
                                    <td class="text-center fw-semibold">@payment.Amount.ToString("N0") đ</td>
                                    <td class="text-center">
                                        <span class="@statusClass">@payment.PaymentStatus</span>
                                    </td>
                                    <td class="text-center">@payment.PaymentMethod</td>
                                    <td class="text-center">@(!string.IsNullOrWhiteSpace(payment.TransactionCode) ? payment.TransactionCode : "-")</td>
                                    <td class="text-center">@payment.PaymentDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@payment.Note</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="mb-0 text-muted">Bạn chưa có giao dịch nạp tiền nào.</p>
            }
        </div>
    </div>
</div>
