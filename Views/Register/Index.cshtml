@model LuyenThiTracNghiem.Models.tblUser
@{
    Layout = "_Layout";
}

<div class="auth-hero">
    <div class="auth-shell row g-0">
        <div class="col-lg-5 d-none d-lg-block">
            <div class="auth-visual h-100">
                <div class="badge-pill mb-3">
                    <i class="fas fa-seedling"></i> Tạo tài khoản mới
                </div>
                <div class="text-uppercase small text-white-50 fw-semibold mb-1">Bắt đầu luyện thi</div>
                <h2>Đăng ký ngay</h2>
                <p>Tham gia cộng đồng học tập, mở khóa đề thi và theo dõi tiến độ học tập của bạn.</p>
                <div class="mt-3">
                    <div class="bullet">
                        <i class="far fa-check-circle"></i><span>Lưu hồ sơ và lịch sử thi</span>
                    </div>
                    <div class="bullet">
                        <i class="far fa-check-circle"></i><span>Cập nhật đề mới liên tục</span>
                    </div>
                    <div class="bullet">
                        <i class="far fa-check-circle"></i><span>Tùy chỉnh lộ trình theo mục tiêu</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-7">
            <div class="auth-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="flex-grow-1">
                        <div class="text-uppercase small text-muted fw-semibold">Chào mừng</div>
                        <h3 class="fw-bold mb-1">Tạo tài khoản</h3>
                        <p class="text-muted mb-0">Điền thông tin cá nhân và bảo vệ tài khoản của bạn.</p>
                    </div>
                    <a href="~/" class="d-none d-md-inline-block">
                        <img src="~/assets/img/logo/logo.png"
                             alt="LuyenThiTracNghiem"
                             style="max-width: 80px; height: auto; object-fit: contain;">
                    </a>
                </div>

                <form id="registerForm" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <div class="mb-3 input-stack">
                        <label asp-for="FullName" class="form-label">Họ và tên</label>
                        <div class="input-box">
                            <span class="icon"><i class="far fa-user"></i></span>
                            <input asp-for="FullName" id="FullName" class="form-control" placeholder="Nhập họ và tên" required />
                        </div>
                        <span asp-validation-for="FullName" class="text-danger"></span>
                        <div class="text-danger mt-1" id="FullNameError" style="font-size: 0.85rem;"></div>
                    </div>

                    <div class="mb-3 input-stack">
                        <label asp-for="BirthDate" class="form-label">Ngày sinh</label>
                        <div class="input-box">
                            <span class="icon"><i class="far fa-calendar-alt"></i></span>
                            <input asp-for="BirthDate" id="BirthDate" type="date" class="form-control" />
                        </div>
                        <div class="text-danger mt-1" id="BirthDateError" style="font-size: 0.85rem;"></div>
                    </div>

                    <div class="mb-3 input-stack">
                        <label asp-for="Gender" class="form-label">Giới tính</label>
                        <div class="input-box">
                            <span class="icon"><i class="fas fa-venus-mars"></i></span>
                            <select asp-for="Gender" id="Gender" name="Gender" class="form-select">
                                <option value="">-- Chọn giới tính --</option>
                                <option value="Nam">Nam</option>
                                <option value="Nữ">Nữ</option>
                                <option value="Khác">Khác</option>
                            </select>
                        </div>
                        <span asp-validation-for="Gender" class="text-danger"></span>
                        <div class="text-danger mt-1" id="GenderError" style="font-size: 0.85rem;"></div>
                    </div>

                    <div class="mb-3 input-stack">
                        <label asp-for="Username" class="form-label">Tên đăng nhập</label>
                        <div class="input-box">
                            <span class="icon"><i class="far fa-user-circle"></i></span>
                            <input asp-for="Username" id="Username" class="form-control" placeholder="Tên đăng nhập" required />
                        </div>
                        <span asp-validation-for="Username" class="text-danger"></span>
                        <div class="text-danger mt-1" id="UsernameError" style="font-size: 0.85rem;"></div>
                    </div>

                    <div class="mb-3 input-stack">
                        <label asp-for="PasswordHash" class="form-label">Mật khẩu</label>
                        <div class="input-box">
                            <span class="icon"><i class="fas fa-lock"></i></span>
                            <input asp-for="PasswordHash" id="PasswordHash" type="password" class="form-control" placeholder="••••••••" required />
                        </div>
                        <span asp-validation-for="PasswordHash" class="text-danger"></span>
                        <div class="text-danger mt-1" id="PasswordHashError" style="font-size: 0.85rem;"></div>
                    </div>

                    <div class="mb-3 input-stack">
                        <label asp-for="PhoneNumber" class="form-label">Số điện thoại</label>
                        <div class="input-box">
                            <span class="icon"><i class="fas fa-phone"></i></span>
                            <input asp-for="PhoneNumber" id="PhoneNumber" class="form-control" placeholder="Số điện thoại" />
                        </div>
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        <div class="text-danger mt-1" id="PhoneNumberError" style="font-size: 0.85rem;"></div>
                    </div>

                    <div class="mb-3 input-stack">
                        <label asp-for="Email" class="form-label">Email</label>
                        <div class="input-box">
                            <span class="icon"><i class="far fa-envelope"></i></span>
                            <input asp-for="Email" id="Email" type="email" class="form-control" placeholder="Email" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger"></span>
                        <div class="text-danger mt-1" id="EmailError" style="font-size: 0.85rem;"></div>
                    </div>

                    <button type="submit" class="auth-btn">Đăng ký</button>
                </form>
                <div class="auth-footer">
                    <small>Đã có tài khoản? <a class="lg" href="~/Login" style="color: #000;">Đăng nhập</a></small>
                </div>
            </div>
        </div>
    </div>
</div>
<link rel="stylesheet" href="~/assets/css/register-user.css" asp-append-version="true" />
<script src="~/assets/js/register-validation.js"></script>
